<?xml version="1.0" encoding="utf-8"?>
<!--
  Template del manifest MSIX per Franchetti Raw Converter Pro.
  I segnaposto {{...}} vengono sostituiti da tools\build_msix.py.

  IMPORTANTE per lo Store:
  - Identity/@Name e Identity/@Publisher devono corrispondere ESATTAMENTE ai
    valori "Package/Identity/Name" e "Package/Identity/Publisher" mostrati in
    Partner Center (Product identity) per il prodotto MSIX.
  - L'architettura e' x64.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="{{IDENTITY_NAME}}"
    Publisher="{{PUBLISHER}}"
    Version="{{VERSION}}"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>{{DISPLAY_NAME}}</DisplayName>
    <PublisherDisplayName>{{PUBLISHER_DISPLAY_NAME}}</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>{{DESCRIPTION}}</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="it-IT" />
  </Resources>

  <Applications>
    <Application Id="App"
                 Executable="FranchettiRawConverterPro.exe"
                 EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="{{DISPLAY_NAME}}"
        Description="{{DESCRIPTION}}"
        BackgroundColor="#101720"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile
          Wide310x150Logo="Assets\Wide310x150Logo.png"
          Square310x310Logo="Assets\Square310x310Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#101720" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <!-- Applicazione desktop completa: nessuna virtualizzazione del registro
         o del filesystem, accesso a fotocamere, rete, cartelle utente. -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
